# ============================================
# CONFIGURAÇÃO DA API - FutTracker Frontend
# ============================================
# 
# Este ficheiro serve como exemplo das variáveis de ambiente necessárias.
# Copia este ficheiro para .env e preenche com os teus valores.
#
# IMPORTANTE: O ficheiro .env não deve ser commitado (está no .gitignore)
# ============================================

# URL base da API (backend)
# Desenvolvimento local: http://localhost:3000/api
# Produção (Render): https://futtracker-kl7r.onrender.com/api
VITE_API_URL=https://futtracker-kl7r.onrender.com/api

# API Key (opcional, só necessária para operações de escrita)
# Obtém esta chave do backend (.env do servidor)
VITE_API_KEY=
